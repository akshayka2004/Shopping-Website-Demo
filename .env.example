# Store Configuration
NEXT_PUBLIC_STORE_NAME="ATELIER VÉRA"
NEXT_PUBLIC_STORE_TAGLINE="Contemporary Everyday Clothing & Essentials"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# Authentication (JWT HTTP-Only Cookie Secret)
JWT_SECRET="super-secret-atelier-vera-jwt-signing-key-2026"

# Database (PostgreSQL connection string for Prisma in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clothing_store?schema=public"

# Payment Gateway (Razorpay Key ID & Secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_AtelierVeraDemoKey"
RAZORPAY_KEY_SECRET="rzp_test_secret_AtelierVera2026"
RAZORPAY_WEBHOOK_SECRET="whsec_AtelierVeraWebhook2026"

# Image Delivery (Cloudinary optional integration)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo-clothing-store"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

